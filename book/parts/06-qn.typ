#exam-q("2018-2019", "三")
#ans[
  #step[1. 证明 DFP 法是下降算法]
  先证各 $H_k$ 对称正定。$H_0 = I$ 正定。设 $H_k$ 对称正定，$g_k != 0$，$p_k = -H_k g_k$。精确直线搜索使 $s_k^T g_(k+1) = 0$，于是
  $ s_k^T y_k = s_k^T g_(k+1) - s_k^T g_k = -t_k p_k^T g_k = t_k g_k^T H_k g_k > 0. $
  对任意 $z != 0$，记 $a = H_k^(1/2) z$，$b = H_k^(1/2) y_k$，
  $ z^T H_(k+1) z = (a^T a dot b^T b - (a^T b)^2) / (b^T b) + (z^T s_k)^2 / (s_k^T y_k). $
  由 Cauchy–Schwarz 不等式，第一项 $>= 0$，只有 $z$ 与 $y_k$ 平行时为 0；这时 $z = lambda y_k$（$lambda != 0$），第二项 $= lambda^2 s_k^T y_k > 0$。所以 $H_(k+1)$ 正定。

  #concl[$g_k^T p_k = -g_k^T H_k g_k < 0$，每次迭代的搜索方向都是下降方向，DFP 法是下降算法。]

  #step[2. 梯度]
  $ g(x) = vec(6 x_1 + 2 x_2 - 2, 2 x_1 + 4 x_2 - 2), quad Q = mat(6, 2; 2, 4). $

  #step[第 1 次迭代]
  $ x_0 &= (0, 1)^T, quad g_0 = (0, 2)^T, quad p_0 = (0, -2)^T, \
    t_0 &= 4/16 = 1/4, quad x_1 = (0, 1/2)^T. $

  #step[校正]
  $ g_1 &= (-1, 0)^T, quad s_0 = (0, -1/2)^T, quad y_0 = (-1, -2)^T, \
    s_0^T y_0 &= 1, quad H_0 y_0 = (-1, -2)^T, quad y_0^T H_0 y_0 = 5, \
    H_1 &= mat(1, 0; 0, 1) + mat(0, 0; 0, 1/4) - mat(1/5, 2/5; 2/5, 4/5) = mat(4/5, -2/5; -2/5, 9/20). $

  #step[第 2 次迭代]
  $ p_1 &= -H_1 g_1 = -mat(4/5, -2/5; -2/5, 9/20) vec(-1, 0) = (4/5, -2/5)^T, \
    t_1 &= -(g_1^T p_1)/(p_1^T Q p_1) = (4\/5)/(16\/5) = 1/4, \
    x_2 &= x_1 + t_1 p_1 = (1/5, 2/5)^T. $
  $g(x_2) = (0, 0)^T$；$Q$ 的顺序主子式 $6, 20$ 全正。

  #concl[$x^* = (1/5, 2/5)^T$ 是全局极小点，$f^* = 2/5$。]
]

