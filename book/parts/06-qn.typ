  $ p_1 &= -H_1 g_1 = -vec(-3/2 + 1/2, 1/2 - 1/2) = (1, 0)^T, \
    t_1 &= -(g_1^T p_1)/(p_1^T Q p_1) = 1/2, \
    x^((2)) &= x^((1)) + t_1 p_1 = (3/2, -1)^T. $
  $g(x^((2))) = (0, 0)^T$；$Q$ 的顺序主子式 $2, 4$ 全正。

  #concl[$x^* = (3/2, -1)^T$ 是全局极小点，$f^* = -5/4$。]
]

