#pred-q[
  用 DFP 法求解 $min f(x) = 2 x_1^2 + 2 x_1 x_2 + x_2^2 - 2 x_1$，初始点 $x_0 = (-1, 2)^T$，$H_0 = I$。求出最优解，并验证 $H_1$ 满足拟 Newton 条件、$H_2 = Q^(-1)$。
]
#ans[
  #step[梯度]
  $ g(x) = vec(4 x_1 + 2 x_2 - 2, 2 x_1 + 2 x_2), quad Q = mat(4, 2; 2, 2). $

  #step[第 1 次迭代]
  $ g_0 &= (-2, 2)^T, quad p_0 = (2, -2)^T, quad t_0 = 8/8 = 1, quad x_1 = (1, 0)^T. $

  #step[校正]
  $ g_1 &= (2, 2)^T, quad s_0 = (2, -2)^T, quad y_0 = (4, 0)^T, \
    s_0^T y_0 &= 8, quad H_0 y_0 = y_0, quad y_0^T H_0 y_0 = 16, \
    H_1 &= mat(1, 0; 0, 1) + mat(1/2, -1/2; -1/2, 1/2) - mat(1, 0; 0, 0) = mat(1/2, -1/2; -1/2, 3/2). $
  验算：$H_1 y_0 = (2, -2)^T = s_0$，满足拟 Newton 条件。

  #step[第 2 次迭代]
  $ p_1 &= -H_1 g_1 = (0, -2)^T, quad t_1 = 4/8 = 1/2, quad x_2 = (1, -1)^T. $
  $g(x_2) = (0, 0)^T$，$Q$ 正定。
  #concl[$x^* = (1, -1)^T$，$f^* = -1$。]

  #step[验证 $H_2 = Q^(-1)$]
  $ s_1 &= (0, -1)^T, quad y_1 = (-2, -2)^T, quad s_1^T y_1 = 2, quad H_1 y_1 = (0, -2)^T, quad y_1^T H_1 y_1 = 4, \
    H_2 &= H_1 + mat(0, 0; 0, 1/2) - mat(0, 0; 0, 1) = mat(1/2, -1/2; -1/2, 1) = 1/4 mat(2, -2; -2, 4) = Q^(-1). $
]

