#exam-q("2022-2023", "三")
#ans[
  #step[梯度]
  $ g(x) = vec(2 x_1 + x_2 - 1, x_1 + 2 x_2 + 2, 2 x_3), quad Q = mat(2, 1, 0; 1, 2, 0; 0, 0, 2). $

  #step[第 1 次迭代]
  $ x^((0)) &= (1, -1, 1)^T, quad g_0 = (0, 1, 2)^T, quad p_0 = (0, -1, -2)^T, \
    t_0 &= norm(g_0)^2 / (g_0^T Q g_0) = 5/10 = 1/2, quad x^((1)) = (1, -3/2, 0)^T. $

  #step[校正]
  $ g_1 &= (-1/2, 0, 0)^T, quad s_0 = (0, -1/2, -1)^T, quad y_0 = (-1/2, -1, -2)^T, \
    s_0^T y_0 &= 5/2, quad H_0 y_0 = y_0, quad y_0^T H_0 y_0 = 21/4, \
    H_1 &= I + mat(0, 0, 0; 0, 1/10, 1/5; 0, 1/5, 2/5) - mat(1/21, 2/21, 4/21; 2/21, 4/21, 8/21; 4/21, 8/21, 16/21) \
      &= mat(20/21, -2/21, -4/21; -2/21, 191/210, -19/105; -4/21, -19/105, 67/105). $

  #step[第 2 次迭代]
  $ p_1 &= -H_1 g_1 = 1/2 (20/21, -2/21, -4/21)^T = (10/21, -1/21, -2/21)^T, \
    t_1 &= -(g_1^T p_1)/(p_1^T Q p_1) = (5\/21)/(190\/441) = 21/38, \
    x^((2)) &= x^((1)) + t_1 p_1 = (24/19, -29/19, -1/19)^T. $

  #step[判断]
