  #step[(1) 标准形]
  $ min f = x_1^2 + 4 x_2^2, quad s = x_2 - x_1 - 1 >= 0. $

  #step[K-T 条件]
  $ 2 x_1 + mu = 0, quad 8 x_2 - mu = 0, quad mu (x_2 - x_1 - 1) = 0, quad mu >= 0. $

  #step[情况 1：$mu = 0$]
  $x = (0, 0)^T$，$s = -1 < 0$，不容许。

  #step[情况 2：$mu > 0$]
  $ x_2 = x_1 + 1, quad x_1 = -mu/2, quad x_2 = mu/8 quad => quad 5/8 mu = 1, quad mu = 8/5, quad x = (-4/5, 1/5)^T. $

  #concl[凸规划，$x^* = (-4/5, 1/5)^T$ 是全局最优解，$f^* = 4/5$。]

  #step[(2) 二阶充分条件]
  设 $f$、$h_1, dots, h_l$ 二次连续可微，$L(overline(x), lambda) = f(overline(x)) - sum_(j=1)^l lambda_j h_j (overline(x))$。若存在 $overline(x)^*$、$lambda^*$ 使
  $ nabla f(overline(x)^*) - sum_(j=1)^l lambda_j^* nabla h_j (overline(x)^*) = 0, quad h_j (overline(x)^*) = 0, $
  并且对所有满足
  $ v^T nabla h_j (overline(x)^*) = 0, quad j = 1, 2, dots, l $
  的非零向量 $v$，都有
  $ v^T nabla_x^2 L(overline(x)^*, lambda^*) v > 0, $
  #concl[那么 $overline(x)^*$ 是严格局部极小点。]
]

