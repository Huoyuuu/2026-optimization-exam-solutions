#ans[
  #step[化成标准形]
  $ s_1 &= 5 + x_1^2 - 2 x_2^2 - 3 x_3 >= 0, quad s_2 = x_1 - 2 x_2 + 3 x_3 >= 0, \
    s_3 &= 4 x_1 + 3 x_2 - 2 x_3 - 1 >= 0, quad s_4 = 5 x_1 + x_2 - x_3 >= 0, \
    h &= 3 x_1 + x_2 + 4 x_3 - 5 = 0. $

  #step[找起作用约束]
  在 $overline(x)_0 = (0, 1, 1)^T$：
  $ h = 0, quad s_1 = 0, quad s_2 = 1 > 0, quad s_3 = 0, quad s_4 = 0. $
  起作用的是 $h$、$s_1$、$s_3$、$s_4$（$s_2$ 不起作用，不用检查）。
  $ nabla h &= (3, 1, 4)^T, quad nabla s_1 (overline(x)_0) = (2 x_1, -4 x_2, -3)^T = (0, -4, -3)^T, \
    nabla s_3 &= (4, 3, -2)^T, quad nabla s_4 = (5, 1, -1)^T. $

  #step[检查 $overline(p)_1 = (3, -1, -2)^T$]
  $ nabla h^T overline(p)_1 &= 9 - 1 - 8 = 0, \
    nabla s_1^T overline(p)_1 &= 4 + 6 = 10 > 0, \
    nabla s_3^T overline(p)_1 &= 12 - 3 + 4 = 13 >= 0, \
    nabla s_4^T overline(p)_1 &= 15 - 1 + 2 = 16 >= 0. $
  $h$、$s_3$、$s_4$ 线性，$s_1$ 满足引理 4.3。
  #concl[$overline(p)_1$ *是*容许方向。]

  #step[检查 $overline(p)_2 = (-1, -1, 1)^T$]
  $ nabla h^T overline(p)_2 &= -3 - 1 + 4 = 0, \
    nabla s_1^T overline(p)_2 &= 4 - 3 = 1 > 0, \
    nabla s_3^T overline(p)_2 &= -4 - 3 - 2 = -9 < 0. $
  沿 $overline(p)_2$ 走一点 $s_3$ 就变负（$s_4$ 也是 $-7 < 0$）。
  #concl[$overline(p)_2$ *不是*容许方向。]
]

