// 驻点判断表：矩阵用陈列公式，各列竖直居中
#let stat-tab(..rows) = {
  show math.equation.where(block: true): set block(above: 0.25em, below: 0.25em)
  align(center, block(breakable: false, three-line(columns: 5, align: horizon + center,
    ([驻点], [$nabla^2 f$], [$Delta_1$], [$Delta_2$], [结论]), ..rows)))
