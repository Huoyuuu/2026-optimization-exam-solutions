#exam-q("2018-2019", "二(2)")
#ans[
  #step[2. 证明 F-R 法是下降算法]
  要证：只要 $g_k != 0$，就有 $g_k^T p_k = -norm(g_k)^2 < 0$。用归纳法。

  $k = 0$ 时 $p_0 = -g_0$，$g_0^T p_0 = -norm(g_0)^2$，成立。

  设第 $k$ 次成立。$x_(k+1)$ 由精确直线搜索得到，$phi'(t_k) = g_(k+1)^T p_k = 0$，于是
  $ g_(k+1)^T p_(k+1) = g_(k+1)^T (-g_(k+1) + alpha_k p_k) = -norm(g_(k+1))^2 + alpha_k g_(k+1)^T p_k = -norm(g_(k+1))^2 < 0. $
  #concl[每次的搜索方向都是下降方向，F-R 法是下降算法。]

  #step[3. 梯度]
  $ g(x) = vec(2 x_1^2 - x_2 - 2, x_2 - x_1, -3 x_3^2). $

  #step[第 1 次迭代]
  $ x_0 &= (0, 0, 0)^T, quad g_0 = (-2, 0, 0)^T, quad p_0 = (2, 0, 0)^T, \
    phi(t) &= f(2 t, 0, 0) = 16/3 t^3 - 4 t, quad phi'(t) = 16 t^2 - 4 = 0 quad => quad t_0 = 1/2, \
    x_1 &= (1, 0, 0)^T, quad f(x_1) = -4/3. $

  #step[第 2 次迭代]
  $ g_1 &= (0, -1, 0)^T, quad alpha_0 = norm(g_1)^2 / norm(g_0)^2 = 1/4, \
    p_1 &= -g_1 + alpha_0 p_0 = (0, 1, 0)^T + (1/2, 0, 0)^T = (1/2, 1, 0)^T, \
    phi(t) &= f(1 + t/2, t, 0) = 1/12 t^3 + 1/2 t^2 - t - 4/3, \
    phi'(t) &= 1/4 (t^2 + 4 t - 4) = 0 quad => quad t_1 = 2 sqrt(2) - 2 quad (text("正根")), quad phi''(t_1) = t_1 / 2 + 1 > 0, \
    x_2 &= x_1 + t_1 p_1 = (sqrt(2), 2 sqrt(2) - 2, 0)^T, quad f(x_2) = 2 - 8/3 sqrt(2). $

  #step[判断]
  $ g(x_2) = (4 - 2 sqrt(2), sqrt(2) - 2, 0)^T != 0. $

  #concl[$x_2$ *不是*最优解。实际上 $f(0, 0, x_3) = -x_3^3 -> -oo$（$x_3 -> +oo$），这个问题根本没有最优解。]
]

